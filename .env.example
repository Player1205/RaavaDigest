# Personal Intelligence Engine - Single-User V1 Environment Configuration

# Gemini AI API Key (required for synthesis & topic resolver)
GEMINI_API_KEY=""

# Resend API Key & Email Configuration (required for daily email dispatch)
RESEND_API_KEY=""
NOTIFICATION_EMAIL="user@example.com"
SENDER_EMAIL="briefing@yourdomain.com"

# The Movie Database (TMDB) API Key (optional - built-in fallback provided if empty)
TMDB_API_KEY=""

# Spotify Web API Credentials (optional - built-in fallback provided if empty)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# GitHub Personal Access Token (optional - public API used if empty)
GITHUB_TOKEN=""

# Secret key to secure /api/cron endpoint
CRON_SECRET="personal-intelligence-secure-cron-key"

# App Base URL (used for unsubscribe link & dashboard links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
